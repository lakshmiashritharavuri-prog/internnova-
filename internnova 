  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f0f5ff',
              100: '#e0ebfe',
              200: '#bae0fd',
              400: '#38bdf8',
              500: '#0284c7',
              600: '#4f46e5',
              700: '#4338ca',
              purple: '#8b5cf6',
              pink: '#ec4899',
              dark: '#080B16',
              card: 'rgba(15, 23, 42, 0.65)',
              border: 'rgba(255, 255, 255, 0.08)'
            }
          },
          animation: {
            'glow-pulse': 'glow 8s ease-in-out infinite alternate',
            'float': 'float 6s ease-in-out infinite',
          },
          keyframes: {
            glow: {
              '0%': { transform: 'scale(1) translate(0px, 0px)', opacity: 0.35 },
              '100%': { transform: 'scale(1.2) translate(30px, 20px)', opacity: 0.7 }
            },
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-10px)' }
            }
